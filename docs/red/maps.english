    For "Route 1:5,24", "Route 1:15,13", "Viridian City:13,20", "Viridian City:30,25", "Viridian Mart:5,5", "Viridian Forest:16,43", "Viridian Forest:27,40", "Pewter City:35,16", "Pewter Mart:3,3" or "Pewter House:4,5", use "Youngster".
    For "Viridian City:30,8", "Viridian House:5,3", "Pewter House:2,3" or "Nidoran House:1,2", use "Man".
    For "Viridian City:18,9" or "Viridian City:17,5", use "Old Man".
    For "Viridian Mart:3,3", use "Customer".
    For "Viridian Center:10,5" or "Pewter Center:11,7", use "Gentleman".
    For "Viridian Center:4,3", "Forest North Gate:3,2", "Pewter City:8,15", "Pewter City:17,25", "Pewter City:27,17", "Pewter City:26,25" or "Pewter Mart:5,5", use "Visitor".
    For "Viridian Center:11,2" or "Pewter Center:11,2", use "Receptionist".
