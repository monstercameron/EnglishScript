  "Caterpie" has 45, 30, 35, 20 and 45.
  "Metapod" has 50, 20, 55, 25 and 30.
  "Butterfree" has 60, 45, 50, 80 and 70.
  "Pidgey" has 40, 45, 40, 35 and 56.
  "Pidgeotto" has 63, 60, 55, 50 and 71.
  "Pidgeot" has 83, 80, 75, 70 and 91.
  "Rattata" has 30, 56, 35, 25 and 72.
  "Raticate" has 55, 81, 60, 50 and 97.
  "Nidoran F" has 55, 47, 52, 40 and 41.
  "Nidorina" has 70, 62, 67, 55 and 56.
